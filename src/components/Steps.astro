---
import Icon from "./Icon.astro";
import { links } from "../site";

const steps = [
  {
    icon: "download",
    title: "Install it",
    text: "Run the installer on a Mac or Windows PC. It runs in the background from then on, starting with your computer.",
  },
  {
    icon: "radar",
    title: "Find your printers",
    text: "Scan your network and add what it finds, typing only what it can't read, like an access code.",
  },
  {
    icon: "play",
    title: "Print",
    text: "Upload, start and watch your prints from any phone, tablet or laptop on your network.",
  },
];
---

<section class="section band">
  <div class="container">
    <div class="section-head row">
      <div>
        <p class="eyebrow">
          <span class="layer-tag">L06</span>From download to first print
        </p>
        <h2>Up and printing in three steps</h2>
        <p class="sub">
          Install it once, let it find your printers, then print from any browser on your network.
        </p>
      </div>
      <a class="text-link" href={links.gettingStarted}>
        Read the setup guide <Icon name="arrow-ur" />
      </a>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <div class="step-top">
            <span class="sq-icon">
              <Icon name={s.icon} />
            </span>
            <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
            {i < steps.length - 1 && <span class="toolpath" aria-hidden="true" />}
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
