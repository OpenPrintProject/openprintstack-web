---
/** The mark: three printed layers, the top one still printing under the nozzle. */
interface Props {
  size?: "sm" | "md";
  /** "plate" draws it in ink and gold, for the build-plate card. */
  on?: "accent" | "plate";
}
const { size, on = "accent" } = Astro.props;
const bg = on === "plate" ? "logo-bg-ink" : "logo-bg";
const layer = on === "plate" ? "logo-layer-gold" : "logo-layer";
---

<span class:list={["logo", size]} aria-hidden="true">
  <svg viewBox="0 0 32 32">
    <rect width="32" height="32" rx="8" class={bg}></rect>
    <rect x="7" y="21.5" width="18" height="3.4" rx="1.2" class={layer}></rect>
    <rect x="7" y="16.8" width="18" height="3.4" rx="1.2" class={layer}></rect>
    <rect x="7" y="12.1" width="9.5" height="3.4" rx="1.2" class={layer}></rect>
    <path d="M17.6 4.5h5v3.6h-5z M18.4 8.1h3.4l-1.7 2.7z" class={layer}></path>
  </svg>
</span>
