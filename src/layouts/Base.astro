---
// Fonts are served from this site rather than a font CDN, so visitors'
// browsers don't contact anyone else.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import Icons from "../components/Icons.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FilamentPicker from "../components/FilamentPicker.astro";
import { site, url } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** Leave the page out of search results, as the 404 page is. */
  noindex?: boolean;
}

const title = Astro.props.title ?? `${site.name} — ${site.tagline}`;
const description = Astro.props.description ?? site.description;
const { noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111317" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <Icons />
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <FilamentPicker />}
  </body>
</html>
